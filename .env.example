# Local configuration knobs (all optional; these are the defaults).
# Copy to .env and adjust, or export directly.

# SQLite database file (created on first start)
CRP_DATABASE_PATH=./data/commit_reveal.db

# Loopback-only bind
CRP_HOST=127.0.0.1
CRP_PORT=8529

# Minimum reveals required for a round to draw (otherwise it aborts)
CRP_DEFAULT_MIN_REVEALS=2

# Log level for the structured audit/application logs
CRP_LOG_LEVEL=INFO
