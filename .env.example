# Copy to .env or export into the shell. Every value has a safe local default.
# SQLite database file used by the evidence store (":memory:" is allowed for tests).
DEFEASIBLE_DB_PATH=data/defeasible.db
# JSONL run log used to replay problems (run id, intermediate states, reasons).
DEFEASIBLE_LOG_PATH=logs/runs.jsonl
# Engine safety limits (distinguish genuine resource exhaustion from other failures).
DEFEASIBLE_MAX_GROUND_RULES=100000
DEFEASIBLE_MAX_CHAINS=1000
DEFEASIBLE_MAX_ROUNDS=1000
# HTTP server bind address used by `python -m defeasible.cli serve`.
DEFEASIBLE_HOST=127.0.0.1
DEFEASIBLE_PORT=8000
