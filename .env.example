# Example local configuration. Copy to .env or export before running.
# Minimizer parameters (must match between index and query of a run)
MINISEED_K=9
MINISEED_W=5
# Repetitive minimizer outbreak guard: max reference offsets per hash bucket
MINISEED_MAX_BUCKET=200
# Abort a query once it would produce more than this many candidate hits
MINISEED_MAX_CANDIDATES=500
# SQLite database location
MINISEED_DB=data/miniseed.db
