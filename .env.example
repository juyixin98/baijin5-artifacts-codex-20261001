# RD backend configuration (copy to .env or export in shell)
# SQLite database location for run persistence
RD_DB_PATH=data/rd.db
# Log level for the application logger
RD_LOG_LEVEL=INFO
# Also emit structured JSONL logs to this file (empty = stderr only)
RD_LOG_FILE=logs/rd.jsonl
# Default server
RD_HOST=127.0.0.1
RD_PORT=8000
