# Paired randomization-inference service configuration (sample).
# Copy to .env or export directly. Every variable is optional; the values
# shown are the defaults used during development and testing.

# SQLite database file (local synthetic data only).
PAIRTEST_DB_PATH=./data/service.db

# A full paired randomization set has 2**n_pairs assignments. Exact
# enumeration is used while 2**n_pairs <= this budget; above it p-values
# switch to Monte Carlo and the response is marked approximate.
PAIRTEST_EXACT_BUDGET=65536

# Probability-ordering inversion requires all pairwise assignment crossings.
# Beyond this many crossings (size*(size-1)/2) inversion uses a grid+bisect
# approximation (still exact p-values when 2**n <= exact budget).
PAIRTEST_CROSSING_BUDGET=2000000

# Monte Carlo approximation parameters.
PAIRTEST_MC_DRAWS=10000
PAIRTEST_MC_SEED=20260927

# Approximate inversion resolution.
PAIRTEST_INVERSION_GRID=4096
PAIRTEST_INVERSION_REFINE=40

# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
PAIRTEST_LOG_LEVEL=INFO
