# Example configuration for the segmented AEAD service.
# Copy to `.env` or export the variables before launching. All paths are local.

# SQLite database holding stream state, segment receipts and the audit trail.
SSEA_DB_PATH=./data/ssea.sqlite3

# Directory for per-segment verified plaintext fragments (created 0700).
SSEA_STAGING_DIR=./data/staging

# Directory for released, fully authenticated plaintext (created 0700).
SSEA_RELEASE_DIR=./data/released

# AEAD backend: "cryptography" (default) or "pycryptodome".
SSEA_AEAD_BACKEND=cryptography

# Protocol size limits.
SSEA_MAX_SEGMENT_BYTES=1048576
SSEA_MAX_TOTAL_BYTES=67108864

# HTTP bind address.
SSEA_HOST=127.0.0.1
SSEA_PORT=8080

# Log level: DEBUG|INFO|WARNING|ERROR
SSEA_LOG_LEVEL=INFO
