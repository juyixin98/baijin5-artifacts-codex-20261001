# psi-server configuration example.
# The server reads these environment variables; no config file is required.
# Copy to server.env and `source server.env`, or set them inline.

# Listen address.
PSI_BIND_ADDR=127.0.0.1:38711

# SQLite database path (":memory:" is NOT supported via env; use a file path
# so audit records survive restarts). Default: psi.db
PSI_DB_PATH=psi.db

# Maximum number of points accepted per submission (per party).
PSI_MAX_SET_SIZE=100000

# Maximum HTTP body size in bytes.
PSI_MAX_BODY_BYTES=67108864

# Log filter (tracing-subscriber EnvFilter syntax).
RUST_LOG=psi_dh=info
