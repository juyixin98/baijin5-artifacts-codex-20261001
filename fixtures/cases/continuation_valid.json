{
  "name": "continuation_valid",
  "description": "HEADERS without END_HEADERS followed by CONTINUATION with END_HEADERS reassembles one legal header block",
  "rfc": "RFC 7540 \u00a76.10",
  "config": {
    "max_frame_size": 16384,
    "initial_recv_window": 65535,
    "send_queue_capacity": 256,
    "max_pending_body_bytes": 1048576,
    "large_body_bytes": 70000
  },
  "steps": [
    {
      "action": "send_server_settings",
      "expect": [
        {
          "type": "SETTINGS",
          "flags": 0,
          "stream": 0,
          "length": 12,
          "payload_hex": "00040000ffff000500004000"
        }
      ]
    },
    {
      "feed_hex": "000000040000000000",
      "expect": [
        {
          "type": "SETTINGS",
          "flags": 1,
          "stream": 0,
          "length": 0
        }
      ]
    },
    {
      "feed_hex": "0000050101000000018204012f86000009090400000001010766697874757265",
      "expect": [
        {
          "type": "HEADERS",
          "flags": 4,
          "stream": 1,
          "payload_hex": "880f100a746578742f706c61696e"
        },
        {
          "type": "DATA",
          "flags": 0,
          "stream": 1,
          "length": 9
        },
        {
          "type": "DATA",
          "flags": 1,
          "stream": 1,
          "length": 0
        }
      ],
      "comment": "reassembled header block is processed normally"
    }
  ]
}