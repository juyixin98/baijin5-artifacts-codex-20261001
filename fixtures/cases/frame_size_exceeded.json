{
  "name": "frame_size_exceeded",
  "description": "A frame payload longer than the advertised SETTINGS_MAX_FRAME_SIZE is a connection-level FRAME_SIZE_ERROR",
  "rfc": "RFC 7540 \u00a74.2",
  "config": {
    "max_frame_size": 16384,
    "initial_recv_window": 65535,
    "send_queue_capacity": 256,
    "max_pending_body_bytes": 1048576,
    "large_body_bytes": 70000
  },
  "steps": [
    {
      "action": "send_server_settings",
      "expect": [
        {
          "type": "SETTINGS",
          "flags": 0,
          "stream": 0,
          "length": 12,
          "payload_hex": "00040000ffff000500004000"
        }
      ]
    },
    {
      "feed_hex": "000000040000000000",
      "expect": [
        {
          "type": "SETTINGS",
          "flags": 1,
          "stream": 0,
          "length": 0
        }
      ]
    },
    {
      "feed_hex": "0000120104000000018304052f6563686f86010766697874757265",
      "expect": []
    },
    {
      "feed_hex": "",
      "expect": [
        {
          "type": "GOAWAY",
          "stream": 0,
          "error_code": "FRAME_SIZE_ERROR"
        }
      ],
      "expect_conn_error": "FRAME_SIZE_ERROR",
      "expect_conn_closed": true
    }
  ]
}